server {
    listen 80;
    server_name foodgramkuzmich.zapto.org;

    location /static/ {
        alias /home/yc-user/foodgram/backend/staticfiles/;
    }

    location /media/ {
        alias /home/yc-user/foodgram/backend/media/;
    }

    location / {
        proxy_pass http://backend:8000;  # если внутри docker-compose
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
